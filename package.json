{
  "name": "bayti-hub-backend",
  "description": "BaytiHub API",
  "private": true,
  "scripts": {
    "start": "APP_ENV=staging node src/main.js",
    "start:dev": "APP_ENV=staging node --watch src/main.js",
    "start:staging": "APP_ENV=staging node --watch src/main.js",
    "start:production": "APP_ENV=production node --watch src/main.js",
    "start:jobs": "JOBS=on APP_ENV=staging node src/main.js",
    "serve": "firebase emulators:start --only functions",
    "logs": "firebase functions:log",
    "deploy:staging": "firebase use homed-food-staging && firebase functions:config:set env.value=\"staging\" && firebase deploy --only functions",
    "deploy:production": "firebase use home-food-plus && firebase functions:config:set env.value=\"production\" && firebase deploy --only functions"
  },
  "engines": {
    "node": "18"
  },
  "main": "index.js",
  "dependencies": {
    "@google-cloud/translate": "^6.3.1",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "algoliasearch": "^4.14.1",
    "apollo-server-express": "^2.26.1",
    "axios": "^0.27.2",
    "big-integer": "^1.6.52",
    "colors": "^1.4.0",
    "cors": "^2.8.5",
    "cron": "^4.4.0",
    "exceljs": "^4.4.0",
    "express": "^4.18.1",
    "express-graphql": "^0.12.0",
    "firebase": "^9.8.2",
    "firebase-admin": "^11.11.1",
    "firebase-functions": "^4.7.0",
    "geofire-common": "^6.0.0",
    "graphql": "^14.7.0",
    "graphql-2-json-schema": "^0.9.1",
    "graphql-iso-date": "^3.6.1",
    "graphql-tools": "^10.0.8",
    "graphql-type-json": "^0.3.2",
    "jest": "^28.1.3",
    "loading-spinner": "^1.2.1",
    "lodash": "^4.17.21",
    "moment": "^2.29.3",
    "node-fetch": "^2.7.0",
    "node-geocoder": "^4.2.0",
    "pdfkit-table": "^0.1.99",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^7.0.3",
    "validator": "^13.7.0",
    "voilab-pdf-table": "^0.5.1",
    "xhr2": "^0.2.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "eslint": "^8.16.0",
    "eslint-config-google": "^0.14.0",
    "nodemon": "^2.0.4"
  }
}
