rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /admin/avatars/iam/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /admin/avatars/profile/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /chefs/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /clients/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /captains/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /requests/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /category/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /complaints/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /notifications/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /sliders/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
